# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=threat_intel

# OSINT API Keys
ALIENVAULT_API_KEY=your_alienvault_api_key_here
ABUSEDB_API_KEY=your_abusedb_api_key_here

# Rate Limiting (requests per minute)
RATE_LIMIT_DEFAULT=60

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# DGA Machine Learning Detection
DGA_THRESHOLD=0.9

# LLM Incident Reporting (default: none for local template generation)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
